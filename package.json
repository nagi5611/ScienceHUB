{
  "name": "sciencehub",
  "version": "0.1.0",
  "private": true,
  "description": "科学研究向けファイル共有・プロジェクト管理 HUB（Cloudflare Pages + D1 + R2）",
  "type": "module",
  "scripts": {
    "dev": "node scripts/ensure-ffmpeg-wasm.mjs && wrangler pages dev public -c wrangler.jsonc -c workers/image-converter/wrangler.jsonc",
    "dev:collab": "wrangler dev --config workers/excalidraw-collab/wrangler.jsonc --port 8790",
    "dev:all": "wrangler pages dev public --do EXCALIDRAW_COLLAB=ExcalidrawCollabRoom@excalidraw-collab --do DESIGN_COLLAB=DesignCollabRoom@design-collab",
    "build": "npm run build:3dprint-ui && npm run types && npm run typecheck",
    "build:3dprint-ui": "npm run build:3dprint-ui:reservation && npm run build:3dprint-ui:management",
    "build:3dprint-ui:reservation": "VITE_3DPRINT_TARGET=reservation vite build --config apps/3dprint-ui/vite.config.ts",
    "build:3dprint-ui:management": "VITE_3DPRINT_TARGET=management vite build --config apps/3dprint-ui/vite.config.ts",
    "import:3dprint-package": "node apps/3dprint-ui/scripts/import-3dprint-package.mjs",
    "dev:3dprint-ui": "vite --config apps/3dprint-ui/vite.config.ts",
    "test:3dprint-time-slots": "npx tsx --test functions/lib/3dprint/time-slots.test.ts",
    "test:3dprint-reservation": "playwright test -c playwright.3dprint-reservation.config.ts",
    "test:3dprint-management": "playwright test -c playwright.3dprint-management.config.ts",
    "test:3dprint": "npm run test:3dprint-time-slots && npm run test:3dprint-reservation && npm run test:3dprint-management",
    "typecheck": "tsc --noEmit",
    "test:workspace-edits": "npx tsx --test functions/lib/third-party/workspace-edits.test.ts",
    "test:contest-logic": "npx tsx --test functions/lib/contest/applications.submission-status.test.ts functions/lib/contest/display-card-layout.test.ts functions/lib/contest/staff-messages.carousel.test.ts",
    "test:contest": "playwright test tests/contest",
    "test:contest:display-card-layout": "playwright test tests/contest/display-card-layout-editor.spec.ts",
    "test:contest-entry": "playwright test tests/contest-entry",
    "test:contest-entry:display-card": "playwright test tests/contest-entry/display-card-preview.spec.ts",
    "test:contest-entry:unit": "npx tsx --test tests/contest-entry/display-card-preview.unit.test.ts tests/contest-entry/display-card-layout-snap.unit.test.ts tests/contest-entry/display-card-pdf-filename.unit.test.ts",
    "predeploy": "npm run build && node scripts/stash-3dprintmanual-videos.mjs && npm run assets:upload-ffmpeg && npm run db:migrate:remote && npm run storage:index:backfill:kick:remote",
    "assets:restore-3dprintmanual-videos": "node scripts/restore-3dprintmanual-videos.mjs",
    "assets:upload-ffmpeg": "node scripts/upload-ffmpeg-core.mjs",
    "assets:upload-ffmpeg:local": "node scripts/upload-ffmpeg-core.mjs --local",
    "deploy": "wrangler pages deploy public && npm run print-application-pdf:deploy && npm run tp-pipeline:deploy",
    "db:create": "wrangler d1 create sciencehub-db",
    "db:migrate:local": "wrangler d1 migrations apply sciencehub-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply sciencehub-db --remote",
    "storage:index:backfill:remote": "npx tsx scripts/backfill-storage-index-remote.ts",
    "storage:index:backfill:kick:remote": "npx tsx scripts/kick-storage-index-backfill-remote.ts",
    "r2:create": "wrangler r2 bucket create sciencehub-files",
    "types": "wrangler types",
    "admin:set-password": "node scripts/set-remote-admin-password.mjs admin",
    "worker:deploy": "wrangler deploy --config workers/sciencehub-worker/wrangler.jsonc",
    "collab:deploy": "wrangler deploy --config workers/excalidraw-collab/wrangler.jsonc",
    "design-collab:deploy": "wrangler deploy --config workers/design-collab/wrangler.jsonc",
    "tp-pipeline:deploy": "wrangler deploy --config workers/tp-pipeline/wrangler.jsonc",
    "image-converter:deploy": "wrangler deploy --config workers/image-converter/wrangler.jsonc",
    "print-application-pdf:deploy": "wrangler deploy --config workers/print-application-pdf/wrangler.jsonc",
    "print-application-font:upload": "node scripts/upload-print-application-font.mjs",
    "print-application-font:upload:local": "node scripts/upload-print-application-font.mjs --local",
    "test:tp-pipeline": "npx tsx --test functions/lib/third-party/agent-registry.test.ts functions/lib/third-party/gemini-usage.test.ts functions/lib/third-party/implement-edit-recovery.test.ts functions/lib/third-party/implement-edit-scope.test.ts functions/lib/third-party/implement-parallel.test.ts functions/lib/third-party/intent-classify.test.ts functions/lib/third-party/workspace-edits.test.ts",
    "pwa:icons": "node scripts/generate-pwa-icons.mjs",
    "contest:display-card-template": "node scripts/generate-contest-display-card-template.mjs",
    "test:image-converter": "playwright test tests/image-converter",
    "test:image-converter:ui": "playwright test tests/image-converter --ui",
    "test:video-converter": "playwright test tests/video-converter",
    "test:video-editor": "playwright test tests/video-editor",
    "test:video-editor:ui": "playwright test tests/video-editor --ui",
    "test:website-publish": "playwright test tests/website-publish",
    "test:excalidraw": "playwright test -c playwright.excalidraw.config.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260722.1",
    "@fontsource/noto-sans-jp": "^5.2.8",
    "@playwright/test": "^1.62.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.3",
    "typescript": "^5.8.3",
    "vite": "^6.4.5",
    "wrangler": "^4.24.4"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^0.0.11",
    "@ffmpeg/core": "^0.12.6",
    "@ffmpeg/core-mt": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.10",
    "@ffmpeg/util": "^0.12.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "aws4fetch": "^1.0.20",
    "fflate": "^0.8.2",
    "firebase": "^12.16.0",
    "gifenc": "^1.0.3",
    "html2canvas": "^1.4.1",
    "jose": "^6.2.4",
    "jspdf": "^4.2.1",
    "mp4-muxer": "^5.2.2",
    "mp4box": "^0.5.3",
    "pdf-lib": "^1.17.1",
    "three": "^0.164.1"
  }
}
