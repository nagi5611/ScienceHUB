# OpenAI Secure MCP Tunnel 設定（コピーして .tunnel.env に保存）
# https://platform.openai.com/settings/organization/tunnels

# ScienceHUB MCP（必須）
SCIENCEHUB_API_URL=https://s.mmh-virtual.jp
SCIENCEHUB_TOKEN=shat_YOUR_TOKEN_HERE

# OpenAI Tunnel（ChatGPT 連携時に必須）
# Platform > API keys > Restricted > Tunnels Read + Use
CONTROL_PLANE_API_KEY=sk-YOUR_RUNTIME_KEY_HERE
CONTROL_PLANE_TUNNEL_ID=tunnel_YOUR_TUNNEL_ID_HERE

# トンネル作成のみ（任意・admin CLI 用）
# OPENAI_ADMIN_KEY=sk-admin-YOUR_KEY_HERE
