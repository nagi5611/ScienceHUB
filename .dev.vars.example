# Copy to .dev.vars for local wrangler pages dev (do not commit .dev.vars)

# Runa ファイルエージェント（Cloudflare AI API）
# RUNA_OPENAI_API_KEY に Cloudflare API トークン（Account > Workers AI > Read）を設定
# 画像生成（image_generate）も同トークンで Workers AI（Grok Imagine）を呼び出します
RUNA_OPENAI_API_KEY=
# または CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# openai/gpt-5.6-luna は Responses API 専用。AI Gateway 認証（Unified Billing）が必要
# すぐ使う場合は RUNA_MODEL=@cf/moonshotai/kimi-k2.6 も可
RUNA_MODEL=openai/gpt-5.6-luna
# マルチ検索後の重複除去・キュレーション（Workers AI Chat Completions）
# RUNA_MULTI_SEARCH_SUMMARIZE_MODEL=@cf/qwen/qwen3-30b-a3b-fp8
# RUNA_AI_GATEWAY_ID=default
RUNA_MAX_DAILY_TURNS=50
RUNA_MAX_TOOL_ROUNDS=12

# Runa Web 検索（SerpBase API — serpbase_search / serpbase_image_search）
# SERPBASE_APIKEY=

# Runa Web / 画像検索（Serper API — serper_search / serper_image_search）
# SERPER_APIKEY=

# Runa Web / 画像検索（Brave Search API — brave_search / brave_image_search）
# BRAVESEARCH_APIKEY=

# Runa Web 検索（Exa Search API — exa_search）
# EXA_API_KEY=

# 3D印刷 予約者向けメール（Email Service REST API — Pages）
# PRINT_3D_EMAIL_FROM=noreply@yourdomain.com
# PRINT_3D_EMAIL_FROM_NAME=ScienceHUB 3D印刷
# PRINT_3D_EMAIL_REPLY_TO=developer@yourdomain.com
# DEV_EMAIL_TEST_SECRET=local-dev-email-test-only

FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_APP_ID=
FIREBASE_AUTH_DOMAIN=
SIM_SMS_CONSENT_VERSION=2026-03-25-ja-v1
